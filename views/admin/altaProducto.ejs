<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alta producto</title>
</head>
<body>
    <h1>Alta Producto</h1>
    <form action="/admin/alta" method="POST">
    <label>Nombre: <input type="text" name="nombre" required></label><br>
    <label>Tipo:<select name="tipo"><option value="Libro">Libro</option><option value="CD">CD</option></select></label><br>
    <label>Precio: <input type="number" name="precio" required></label><br>
    <label>Imagen: <input type="text" name="img"></label><br>
    <button type="submit">Guardar</button>
</form>
</body>
</html>