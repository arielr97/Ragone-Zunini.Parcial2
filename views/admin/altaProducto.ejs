<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/styles.css">
    <title>Alta producto</title>
</head>
<body>

<main class="admin-main">
    <div class="form-container">
        <h2>Alta de Producto</h2>
        
        <form action="/admin/alta" method="POST" id="form-alta" class="form-admin" enctype="multipart/form-data">

            <div class="form-row">
                <label for="nombre">Nombre:</label>
                <input type="text" id="nombre" name="nombre">
            </div>

            <div class="form-row">
                <label for="tipo">Tipo:</label>
                <select id="tipo" name="tipo">
                    <option value="Libro">Libro</option>
                    <option value="CD">CD</option>
                </select>
            </div>

            <div id="div-autor" class="form-row">
                <label for="autor-input">Autor:</label>
                <input type="text" name="autor" id="autor-input" placeholder="Nombre del autor">
            </div>

            <div id="div-artista" class="form-row">
                <label for="artista-input">Artista:</label>
                <input type="text" name="artista" id="artista-input" placeholder="Nombre del artista">
            </div>

            <div class="form-row">
                <label for="precio">Precio:</label>
                <input type="number" id="precio" name="precio" required placeholder="0.00" min="0" step="0.01">
            </div>

            <div class="form-row">
                <label for="img">Imagen:</label>
                <div class="file-custom-container">
                    <input type="file" id="img" name="img" required>
                </div>
            </div>

            <div class="form-row">
                <label for="cantidadStock">Stock:</label>
                <input type="number" id="cantidadStock" name="cantidadStock" required placeholder="Cantidad disponible" min="0">
            </div>

            <button type="submit" class="btn-submit">Guardar Producto</button>
        </form>
    </div>
</main>

<script>
    const tipo = document.getElementById("tipo");
    const divAutor = document.getElementById("div-autor");
    const divArtista = document.getElementById("div-artista");
    const autorInput = document.getElementById("autor-input");
    const artistaInput = document.getElementById("artista-input");

    function cambioTipo(){
        if (tipo.value === "Libro") {
            divAutor.style.display = "grid"; // Cambiado a grid para mantener la estructura de columnas
            divArtista.style.display = "none";
            autorInput.required = true;
            artistaInput.required = false;
        } else {
            divAutor.style.display = "none";
            divArtista.style.display = "grid"; // Cambiado a grid para mantener la estructura de columnas
            autorInput.required = false;
            artistaInput.required = true;
        }
    }
    cambioTipo();
    tipo.addEventListener("change", cambioTipo);
</script>
</body>
</html>