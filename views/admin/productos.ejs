<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/styles.css">
    <title>Dashboard Productos</title>
</head>
<body>
    <nav>
        <img src="img/logo.png" alt="Logo">
        <h1>Mi Tienda</h1>
        <p>Ariel Ragone | Matias Zunini</p>
        <p>Administrador</p>
    </nav>
    <h1>Productos</h1>
    <a href="/admin/alta"><button>Agregar Producto</button></a>
    <table>
        <thead>
            <tr>
                <th>Imagen</th>
                <th>Nombre</th>
                <th>Tipo</th>
                <th>Autor/Artista</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <% productos.forEach(producto => { %>
            <tr>
                <td><img src="<%= producto.img %>" alt="<%= producto.nombre %>" width="80"></td>
                <td><%= producto.nombre %></td>
                <td><%= producto.tipo %></td>
                <td><%= producto.autor ? producto.autor : producto.artista %></td>
                <td><%= producto.precio %></td>
                <td><%= producto.cantidadStock %></td>
                <td><a href="/admin/editar/<%= producto.id %>"><button>Editar</button></a>
                    <form action="/admin/eliminar/<%= producto.id %>" method="POST">
                        <button type="submit">Eliminar</button>
                    </form>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</body>
</html>