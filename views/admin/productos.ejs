<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/styles.css">
    <title>Dashboard Productos</title>
</head>
<body>
    <h1>Productos</h1>
    <div class="admin-toolbar">
        <form action="/admin/productos" method="GET">
            <select name="tipo">
                <option value="">Todos</option>
                <option value="Libro">Libros</option>
                <option value="CD">CDs</option>
            </select>

            <input type="text" name="busqueda" placeholder="Buscar producto...">
            <button type="submit">Filtrar</button>
        </form>
    <a href="/admin/alta"><button>Agregar Producto</button></a>
    </div>
    
    <table>
        <thead>
            <tr>
                <th>Imagen</th>
                <th>Nombre</th>
                <th>Tipo</th>
                <th>Autor/Artista</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Activo</th>
                <th>ID</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <% productos.forEach(producto => { %>
            <tr>
                <td><img src="<%= producto.img %>" alt="<%= producto.nombre %>" width="80"></td>
                <td><%= producto.nombre %></td>
                <td><%= producto.tipo %></td>
                <td><%= producto.autor ? producto.autor : producto.artista %></td>
                <td><%= producto.precio %></td>
                <td><%= producto.cantidadStock %></td>
                <td><b><%= producto.activo == true ? "SI" : "NO" %></b></td>
                <td><b><%= producto.id %></b></td>
                <td>
                <div class="acciones">
                    <a href="/admin/editar/<%= producto.id %>">
                        <button>Editar</button>
                    </a>

                    <% if (producto.activo) { %>
                        <form action="/admin/eliminar/<%= producto.id %>" method="POST">
                            <button type="submit">Eliminar</button>
                        </form>
                    <% } else { %>
                        <form action="/admin/activar/<%= producto.id %>" method="POST">
                            <button type="submit">Activar</button>
                        </form>
                    <% } %>
                </div>
            </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</body>
</html>