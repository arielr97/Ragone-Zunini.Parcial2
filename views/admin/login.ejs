<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/styles.css">
    <title>Login Admin</title>
    <link rel="icon" type="image/x-icon" href="/img/logo.ico">
</head>
<body>
    <h1> <%= title %> </h1>
    <form action="/admin/login" method="POST">
        <input type="email" name="email" id="email1" placeholder="Correo" autocomplete="email" required>
        <input type="password" name="password" id="password1" placeholder="Contraseña" required>
        <button type="submit">Ingresar</button>
        <button type="button" id="btnAccesoRapido">Acceso rápido</button>
    </form>
    <script>
    document.getElementById("btnAccesoRapido").addEventListener("click", () => {
        document.getElementById("email1").value = "ola@mail.asd";
        document.getElementById("password1").value = "admin123";
    });
    </script>
</body>
</html>