<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/styles.css">
    <title>Editar producto</title>
    <link rel="icon" type="image/x-icon" href="/img/logo.ico">
</head>
<body>

<main class="admin-main">

    <div class="form-container">
        <h2>Editar Producto</h2>

        <form action="/admin/editar/<%= producto.id %>" method="POST" enctype="multipart/form-data" class="form-admin">

            <div class="form-row">
                <label for="nombre">Nombre:</label>
                <input type="text" id="nombre" name="nombre" value="<%= producto.nombre %>" required>
            </div>

            <div class="form-row">
                <label for="precio">Precio:</label>
                <input type="number" id="precio" name="precio" value="<%= producto.precio %>" min="0.01" step="0.01" required>
            </div>

            <div class="form-row">
                <label for="img">Imagen:</label>
                <input type="file" id="img" name="img">
            </div>

            <div class="form-row">
                <label for="cantidadStock">Stock:</label>
                <input type="number" id="cantidadStock" name="cantidadStock" value="<%= producto.cantidadStock %>" min="0">
            </div>

            <div class="form-row">
                <label for="tipo">Tipo:</label>
                <select id="tipo" name="tipo">
                    <option value="Libro" <%= producto.tipo == "Libro" ? 'selected' : '' %>>Libro</option>
                    <option value="CD" <%= producto.tipo == "CD" ? 'selected' : '' %>>CD</option>
                </select>
            </div>

            <div id="div-autor-editar" class="form-row">
                <label for="autor-input-editar">Autor:</label>
                <input type="text" name="autor" id="autor-input-editar" value="<%= producto.autor %>">
            </div>

            <div id="div-artista-editar" class="form-row">
                <label for="artista-input-editar">Artista:</label>
                <input type="text" name="artista" id="artista-input-editar" value="<%= producto.artista %>">
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-submit">Guardar Producto</button>
                <a href="/admin/productos"><button type="button" class="btn-submit">Volver al listado</button></a>
            </div>

        </form>
    </div>

</main>

</body>
</html>