<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/styles.css">
    <title>Editar Producto</title>
</head>
<body>
    <h1>Modificar Producto</h1>
    <h3>Producto a Editar:</h3>
    <form action="/admin/editar/<%= producto.id %>" method="POST">
        <label>Nombre:<input type="text" name="nombre" value="<%= producto.nombre %>" required></label><br>
        <label>Precio:<input type="number" name="precio" value="<%= producto.precio %>" required></label><br>
        <label>Imagen:<input type="file" name="img" value="<%= producto.img %>"></label><br>
        <label>Cantidad Stock:<input type="number" name="cantidadStock" value="<%= producto.cantidadStock %>"></label><br>
        <button type="submit">Guardar Cambios</button>
    </form>
</body>
</html>